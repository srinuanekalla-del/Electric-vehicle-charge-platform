SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True to use SQLite for quick local testing without MySQL installed.
# Set to False (or remove) to use MySQL with the DB_* settings below.
USE_SQLITE=True

DB_NAME=evcharge_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOW_ALL_ORIGINS=True
